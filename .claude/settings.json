{
  "enabledMcpjsonServers": [
    "roundtable"
  ],
  "permissions": {
    "allow": [
      "mcp__roundtable"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "roundtable hook session-start --agent cutline-studio",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "roundtable hook stop --agent cutline-studio",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "roundtable hook session-end --agent cutline-studio",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
