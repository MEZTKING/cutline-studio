{
  "name": "cutline-studio",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "description": "A touch-first professional video editor: browser PWA and an Electron/FFmpeg Windows build with a DaVinci-style colour page, audio mixer, captions, auto-reframe, and an in-app updater.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/smoke.mjs",
    "test:features": "node tests/features.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test": "node tests/srt.test.mjs && node tests/reframe.test.mjs && node tests/update-core.test.mjs && node tests/bundle.test.mjs && node tests/update-helper.mjs && node tests/smoke.mjs && node tests/features.mjs && node tests/project-settings.mjs && node tests/edit-tools.mjs && node tests/multi-select.mjs && node tests/insert-overwrite.mjs && node tests/audio.mjs && node tests/scrub.mjs && node tests/mobile.mjs && node tests/captions.mjs && node tests/reframe-browser.mjs",
    "test:srt": "node tests/srt.test.mjs",
    "postinstall": "node scripts/sync-mediapipe.mjs",
    "predev": "node scripts/sync-mediapipe.mjs",
    "prebuild": "node scripts/sync-mediapipe.mjs",
    "test:reframe": "node tests/reframe-browser.mjs",
    "test:reframe-math": "node tests/reframe.test.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:dist:win": "npm run build && electron-builder --win --x64",
    "desktop:dist:linux": "npm run build && electron-builder --linux --arm64",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:autosave": "node tests/desktop-autosave.mjs",
    "test:desktop:packaged": "node tests/desktop-packaged.mjs",
    "desktop:dev": "electron .",
    "test:color": "node tests/color.mjs",
    "desktop:pack:win": "npm run build && electron-builder --win --dir",
    "serve:release": "node scripts/serve-release.mjs",
    "test:project": "node tests/project-settings.mjs",
    "test:audio": "node tests/audio.mjs",
    "test:scrub": "node tests/scrub.mjs",
    "test:update-core": "node tests/update-core.test.mjs && node tests/update-helper.mjs",
    "test:updater": "node tests/updater.mjs",
    "update:manifest": "node scripts/make-update-manifest.mjs",
    "test:auto": "node tests/auto-project.mjs",
    "test:desktop:fps": "node tests/desktop-fps.mjs",
    "test:edit": "node tests/edit-tools.mjs",
    "test:cli": "node tests/cli.mjs",
    "cli": "node bin/cutline.cjs",
    "test:bundle": "node tests/bundle.test.mjs",
    "test:desktop:bundle": "node tests/desktop-bundle.mjs",
    "test:queue": "node tests/render-queue.mjs",
    "test:watch": "node tests/watch-folders.mjs",
    "test:multi": "node tests/multi-select.mjs",
    "test:insert": "node tests/insert-overwrite.mjs",
    "test:color2": "node tests/color-secondaries.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.55.0",
    "png-to-ico": "^2.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "studio.cutline.desktop",
    "productName": "Cutline Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/adm-zip/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cutline-Studio-${version}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "Cutline-Studio-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "author": "MEZTKING",
  "repository": {
    "type": "git",
    "url": "https://github.com/MEZTKING/cutline-studio.git"
  },
  "homepage": "https://github.com/MEZTKING/cutline-studio",
  "bugs": {
    "url": "https://github.com/MEZTKING/cutline-studio/issues"
  },
  "bin": {
    "cutline": "bin/cutline.cjs"
  }
}
