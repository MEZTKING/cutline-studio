{
  "name": "cutline-studio",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Cutline Studio — a fast, touch-first timeline editor that runs in the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/smoke.mjs",
    "test:features": "node tests/features.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test": "node tests/srt.test.mjs && node tests/reframe.test.mjs && node tests/smoke.mjs && node tests/features.mjs && node tests/mobile.mjs && node tests/captions.mjs && node tests/reframe-browser.mjs",
    "test:srt": "node tests/srt.test.mjs",
    "postinstall": "node scripts/sync-mediapipe.mjs",
    "predev": "node scripts/sync-mediapipe.mjs",
    "prebuild": "node scripts/sync-mediapipe.mjs",
    "test:reframe": "node tests/reframe-browser.mjs",
    "test:reframe-math": "node tests/reframe.test.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --dir",
    "desktop:dist:win": "npm run build && electron-builder --win --x64",
    "desktop:dist:linux": "npm run build && electron-builder --linux --arm64",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:autosave": "node tests/desktop-autosave.mjs",
    "test:desktop:packaged": "node tests/desktop-packaged.mjs",
    "desktop:dev": "electron .",
    "test:color": "node tests/color.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.55.0",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "studio.cutline.desktop",
    "productName": "Cutline Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cutline-Studio-${version}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "Cutline-Studio-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "author": "Cutline Studio"
}
